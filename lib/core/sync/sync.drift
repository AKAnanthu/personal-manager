-- Google Drive sync (see sync_engine.dart). Every record table has three
-- triggers that note a changed row here; the engine uploads it and removes
-- the entry. Generated by hand from SyncTables: keep the two in step.
-- (An upsert, not INSERT OR REPLACE: a trigger's OR clause is overridden by
-- the statement that fired it, e.g. an INSERT OR ABORT.)
CREATE TABLE sync_outbox (
  tbl TEXT NOT NULL,
  row_id TEXT NOT NULL,
  deleted BOOLEAN NOT NULL DEFAULT FALSE,
  -- Grows with every change, so an entry rewritten during an upload
  -- isn't removed when that upload finishes.
  seq INTEGER NOT NULL,
  PRIMARY KEY (tbl, row_id)
);

-- Drive file of every record and file this phone has uploaded or seen.
CREATE TABLE sync_remote (
  name TEXT NOT NULL PRIMARY KEY,
  file_id TEXT NOT NULL,
  modified TEXT
);

-- While it has a row, changes aren't recorded: applying what came from
-- Drive, and wiping this phone on sign-out.
CREATE TABLE sync_mute (
  id INTEGER NOT NULL PRIMARY KEY
);

CREATE TRIGGER sync_notes_ai AFTER INSERT ON notes
WHEN NOT EXISTS (SELECT 1 FROM sync_mute) BEGIN
  INSERT INTO sync_outbox (tbl, row_id, deleted, seq)
  VALUES ('notes', new.id, 0, (SELECT COALESCE(MAX(seq), 0) + 1 FROM sync_outbox))
  ON CONFLICT (tbl, row_id) DO UPDATE
    SET deleted = excluded.deleted, seq = excluded.seq;
END;

CREATE TRIGGER sync_notes_au AFTER UPDATE ON notes
WHEN NOT EXISTS (SELECT 1 FROM sync_mute) BEGIN
  INSERT INTO sync_outbox (tbl, row_id, deleted, seq)
  VALUES ('notes', new.id, 0, (SELECT COALESCE(MAX(seq), 0) + 1 FROM sync_outbox))
  ON CONFLICT (tbl, row_id) DO UPDATE
    SET deleted = excluded.deleted, seq = excluded.seq;
END;

CREATE TRIGGER sync_notes_ad AFTER DELETE ON notes
WHEN NOT EXISTS (SELECT 1 FROM sync_mute) BEGIN
  INSERT INTO sync_outbox (tbl, row_id, deleted, seq)
  VALUES ('notes', old.id, 1, (SELECT COALESCE(MAX(seq), 0) + 1 FROM sync_outbox))
  ON CONFLICT (tbl, row_id) DO UPDATE
    SET deleted = excluded.deleted, seq = excluded.seq;
END;

