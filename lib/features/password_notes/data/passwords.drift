import 'password_tables.dart';

-- Indexes name, URL and username only. The password column is
-- deliberately excluded.
CREATE VIRTUAL TABLE password_notes_fts USING fts5(
  name, url, username,
  content='password_notes', content_rowid='rowid'
);

CREATE TRIGGER password_fts_ai AFTER INSERT ON password_notes BEGIN
  INSERT INTO password_notes_fts(rowid, name, url, username)
  VALUES (new.rowid, new.name, new.url, new.username);
END;

CREATE TRIGGER password_fts_ad AFTER DELETE ON password_notes BEGIN
  INSERT INTO password_notes_fts(password_notes_fts, rowid, name, url, username)
  VALUES ('delete', old.rowid, old.name, old.url, old.username);
END;

CREATE TRIGGER password_fts_au AFTER UPDATE ON password_notes BEGIN
  INSERT INTO password_notes_fts(password_notes_fts, rowid, name, url, username)
  VALUES ('delete', old.rowid, old.name, old.url, old.username);
  INSERT INTO password_notes_fts(rowid, name, url, username)
  VALUES (new.rowid, new.name, new.url, new.username);
END;
