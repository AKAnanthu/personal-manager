      "name": "note_attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_attachments\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"note_id\" TEXT NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"file_key\" TEXT NOT NULL, \"original_name\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
