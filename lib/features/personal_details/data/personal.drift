import 'personal_tables.dart';

CREATE VIRTUAL TABLE personal_entries_fts USING fts5(
  title, search_text,
  content='personal_entries', content_rowid='rowid'
);

CREATE TRIGGER personal_fts_ai AFTER INSERT ON personal_entries BEGIN
  INSERT INTO personal_entries_fts(rowid, title, search_text)
  VALUES (new.rowid, new.title, new.search_text);
END;

CREATE TRIGGER personal_fts_ad AFTER DELETE ON personal_entries BEGIN
  INSERT INTO personal_entries_fts(personal_entries_fts, rowid, title, search_text)
  VALUES ('delete', old.rowid, old.title, old.search_text);
END;

CREATE TRIGGER personal_fts_au AFTER UPDATE ON personal_entries BEGIN
  INSERT INTO personal_entries_fts(personal_entries_fts, rowid, title, search_text)
  VALUES ('delete', old.rowid, old.title, old.search_text);
  INSERT INTO personal_entries_fts(rowid, title, search_text)
  VALUES (new.rowid, new.title, new.search_text);
END;
